# ── VoiceIQ Environment Variables ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase (safe to expose in frontend — RLS enforces access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic (SERVER SIDE ONLY — never use VITE_ prefix here)
# Add this in Vercel Dashboard → Project Settings → Environment Variables
ANTHROPIC_API_KEY=sk-ant-your-key-here
