# ── VoiceIQ Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase (safe to expose in frontend — RLS enforces access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role (SERVER SIDE ONLY — never use VITE_ prefix)
# Used by background functions to bypass RLS for writes
# Found in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic (SERVER SIDE ONLY — never use VITE_ prefix)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Netlify site URL (set automatically by Netlify in production)
# For local dev: set to http://localhost:8888
URL=https://your-site.netlify.app
